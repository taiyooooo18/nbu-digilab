            window.appData.slots.forEach(slot => {
                const isOverCap = slot.capacity >= 9;
                const card = document.createElement('div');
                card.className = `p-3.5 rounded-xl border ${isOverCap ? 'border-amber-300 bg-amber-50/30' : 'border-slate-200 bg-slate-50'} flex flex-col lg:flex-row justify-between items-start lg:items-center gap-3`;

                card.innerHTML = `
                    <div class="flex flex-wrap items-center gap-2 w-full lg:w-auto">
                        <span class="font-bold text-xs bg-slate-800 text-white px-2 py-1 rounded">枠 #${slot.index + 1}</span>
                        <div class="flex items-center gap-1 bg-white px-2 py-1 border border-slate-300 rounded-lg shadow-sm">
                            <input type="time" value="${slot.startTimeStr}" onchange="requireAdmin(() => updateSlotTime(${slot.index}, 'startTimeStr', this.value))" class="font-mono font-bold text-sm bg-transparent border-none focus:outline-none">
                            <span class="text-slate-400 font-bold">〜</span>
                            <input type="time" value="${slot.endTimeStr}" onchange="requireAdmin(() => updateSlotTime(${slot.index}, 'endTimeStr', this.value))" class="font-mono font-bold text-sm bg-transparent border-none focus:outline-none">
                        </div>
                        <span class="text-xs font-mono bg-slate-200 px-2 py-1 rounded text-slate-700 font-bold">整理券 ${formatTicketNum(slot.startTicket)}〜${formatTicketNum(slot.endTicket)}</span>
                    </div>

                    <div class="flex items-center gap-2 w-full lg:w-auto justify-end">
                        <span class="text-xs text-slate-500 font-bold">定員:</span>
                        <div class="flex gap-1">
                            ${[5,6,7,8].map(cap => `
                                <button onclick="requireAdmin(() => requestCapacityChange(${slot.index}, ${cap}))" class="px-2.5 py-1 rounded-lg text-xs font-bold ${slot.capacity === cap ? 'bg-slate-900 text-white' : 'bg-white border text-slate-700'}">
                                    ${cap}人
                                </button>
                            `).join('')}
                        </div>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        window.updateSlotTime = function(slotIndex, timeType, value) {
            if (window.appData.slots[slotIndex]) {
                window.appData.slots[slotIndex][timeType] = value;
                saveData();
            }
        };

        window.requestCapacityChange = function(slotIndex, newCap) {
            window.appData.slots[slotIndex].capacity = newCap;
            recalculateRanges();
            saveData();
        };

        function recalculateRanges() {
            let currentTicketCounter = Number(window.appData.config.startTicketNum);
            window.appData.slots.forEach(slot => {
                slot.startTicket = currentTicketCounter;
                slot.endTicket = currentTicketCounter + slot.capacity - 1;
                currentTicketCounter += slot.capacity;
            });
            rebuildTicketsMap();
        }

        window.prevSlot = function() {
            if (window.appData.currentSlotIndex > 0) {
                window.appData.currentSlotIndex--;
                saveData();
            }
        };

        window.confirmNextSlot = function() {
            const nextSlot = window.appData.slots[window.appData.currentSlotIndex + 1];
            if (!nextSlot) {
                alert('これが最後の時間枠です。');
                return;
            }
            document.getElementById('nextSlotModalTime').textContent = `${nextSlot.startTimeStr} 〜 ${nextSlot.endTimeStr}`;
            openModal('modalNextSlot');
        };

        window.executeNextSlot = function() {
            if (window.appData.currentSlotIndex < window.appData.slots.length - 1) {
                window.appData.currentSlotIndex++;
                saveData();
                playChimeSound();
            }
            closeModal('modalNextSlot');
        };

        function renderSettingsTab() {
            const { startTime, slotInterval = 30, defaultCapacity, totalSlots, startTicketNum, customBaseUrl = '' } = window.appData.config;
            document.getElementById('cfgStartTime').value = startTime;
            document.getElementById('cfgSlotInterval').value = slotInterval;
            document.getElementById('cfgDefaultCapacity').value = defaultCapacity;
            document.getElementById('cfgTotalSlots').value = totalSlots;
            document.getElementById('cfgStartTicketNum').value = startTicketNum;
            document.getElementById('inputCustomBaseUrl').value = customBaseUrl;

            let total = 0, entered = 0, late = 0, cancelled = 0;
            Object.values(window.appData.tickets).forEach(t => {
                total++;
                if (t.status === 'entered') entered++;
                else if (t.status === 'late') late++;
                else if (t.status === 'cancelled') cancelled++;
            });

            document.getElementById('summaryTotal').textContent = `${total} 枚`;
            document.getElementById('summaryEntered').textContent = `${entered} 人`;
            document.getElementById('summaryLate').textContent = `${late} 人`;
            document.getElementById('summaryCancelled').textContent = `${cancelled} 人`;
        }

        window.applySettings = function() {
            window.appData.config.startTime = document.getElementById('cfgStartTime').value;
            window.appData.config.slotInterval = parseInt(document.getElementById('cfgSlotInterval').value, 10);
            window.appData.config.defaultCapacity = parseInt(document.getElementById('cfgDefaultCapacity').value, 10);
            window.appData.config.totalSlots = parseInt(document.getElementById('cfgTotalSlots').value, 10);
            window.appData.config.startTicketNum = parseInt(document.getElementById('cfgStartTicketNum').value, 10);

            generateSlotsAndTickets();
            saveData();
            alert('スケジュールを再生成しました。');
        };

        window.openDelayAdjustModal = function() {
            document.getElementById('inputDelayMinutes').value = window.appData.delayMinutes;
            openModal('modalDelay');
        };

        window.adjustDelayMinutes = function(delta) {
            const input = document.getElementById('inputDelayMinutes');
            let val = parseInt(input.value, 10) || 0;
            input.value = val + delta;
        };

        window.setDelay = function(minutes) {
            document.getElementById('inputDelayMinutes').value = minutes;
        };

        window.saveDelaySetting = function() {
            const val = parseInt(document.getElementById('inputDelayMinutes').value, 10) || 0;
            window.appData.delayMinutes = val;
            saveData();
            closeModal('modalDelay');
        };

        window.switchTab = function(tabName) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('border-brand-600', 'text-brand-600');
                btn.classList.add('border-transparent', 'text-slate-500');
            });

            document.getElementById(`tab-${tabName}`).classList.remove('hidden');
            const activeBtn = document.getElementById(`tabBtn-${tabName}`);
            if (activeBtn) {
                activeBtn.classList.remove('border-transparent', 'text-slate-500');
                activeBtn.classList.add('border-brand-600', 'text-brand-600');
            }
        };

        window.openModal = function(id) {
            document.getElementById(id)?.classList.remove('hidden');
        };

        window.closeModal = function(id) {
            document.getElementById(id)?.classList.add('hidden');
        };

        window.openResetModal = function() {
            openModal('modalReset');
        };

        window.executeResetData = function() {
            localStorage.removeItem('event_mgmt_local_data');
            initDefaultData();
            saveData();
            closeModal('modalReset');
        };
    </script>
</body>
</html>
