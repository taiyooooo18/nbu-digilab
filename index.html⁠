<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>イベント整理券・入場管理＆リアルタイムサイネージ</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- QR Code Generator Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            500: '#0284c7',
                            600: '#0284c7',
                            700: '#0369a1',
                            900: '#0c4a6e',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            touch-action: manipulation;
            -webkit-tap-highlight-color: transparent;
            user-select: none;
        }
        .btn-touch {
            min-height: 48px;
            transition: transform 0.1s ease, background-color 0.15s ease;
        }
        .btn-touch:active {
            transform: scale(0.96);
        }
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        /* Signage Pulse & Flashing Effects */
        @keyframes subtle-glow {
            0%, 100% { box-shadow: 0 0 20px rgba(14, 165, 233, 0.3); }
            50% { box-shadow: 0 0 40px rgba(14, 165, 233, 0.7); }
        }
        .signage-glow {
            animation: subtle-glow 3s infinite;
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-900 min-h-screen flex flex-col pb-20 md:pb-0">

    <!-- Header -->
    <header class="bg-slate-900 text-white sticky top-0 z-30 shadow-md">
        <div class="max-w-5xl mx-auto px-4 py-2.5 flex justify-between items-center">
            <div class="flex items-center gap-2">
                <span id="roleBadge" class="bg-amber-500 text-slate-950 font-black text-xs px-2 py-0.5 rounded tracking-wider uppercase">管理者</span>
                <h1 class="text-base font-bold truncate">入場管理＆リアルタイム案内</h1>
            </div>
            
            <div class="flex items-center gap-2">
                <!-- Sync Status Indicator -->
                <div id="cloudSyncBadge" class="flex items-center gap-1.5 text-xs bg-slate-800 text-slate-300 px-2.5 py-1 rounded-full border border-slate-700">
                    <span class="w-2 h-2 rounded-full bg-slate-400" id="syncDot"></span>
                    <span id="syncText">オフライン</span>
                </div>

                <!-- Chromebook Signage Switch Button -->
                <button onclick="switchViewMode('display')" class="bg-brand-600 hover:bg-brand-500 text-white font-bold text-xs px-3 py-1.5 rounded-lg flex items-center gap-1.5 shadow">
                    <i class="fa-solid fa-desktop"></i>
                    <span class="hidden sm:inline">Chromebook用画面</span>
                </button>
            </div>
        </div>

        <!-- System Delay Indicator -->
        <div id="delayBanner" class="bg-slate-800 border-t border-slate-700 px-4 py-1.5 text-xs flex justify-between items-center max-w-5xl mx-auto">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-clock-rotate-left text-amber-400"></i>
                <span>進行状態: <strong id="delayText" class="text-white font-semibold">予定通り</strong></span>
            </div>
            <div class="flex gap-2">
                <button onclick="openShareModal()" class="text-xs bg-slate-700 hover:bg-slate-600 px-2.5 py-1 rounded text-slate-200 font-bold flex items-center gap-1">
                    <i class="fa-solid fa-share-nodes text-brand-400"></i> 共有/QR
                </button>
                <button onclick="requireAdmin(openDelayAdjustModal)" class="text-xs bg-slate-700 hover:bg-slate-600 px-2.5 py-1 rounded text-slate-200 font-bold">
                    <i class="fa-solid fa-sliders mr-1"></i>調整
                </button>
            </div>
        </div>
    </header>

    <!-- Global Stats Dashboard Bar -->
    <section class="bg-white border-b border-slate-200 shadow-sm">
        <div class="max-w-5xl mx-auto px-2 py-2 grid grid-cols-5 gap-1 text-center text-xs">
            <div class="bg-slate-50 p-1.5 rounded border border-slate-100">
                <div class="text-slate-500 text-[10px] font-bold">整理券総数</div>
                <div id="statTotalTickets" class="text-base font-black text-slate-800">0</div>
            </div>
            <div class="bg-emerald-50 p-1.5 rounded border border-emerald-100">
                <div class="text-emerald-700 text-[10px] font-bold">入場済み</div>
                <div id="statEntered" class="text-base font-black text-emerald-600">0</div>
            </div>
            <div class="bg-slate-50 p-1.5 rounded border border-slate-200">
                <div class="text-slate-600 text-[10px] font-bold">未入場</div>
                <div id="statUnentered" class="text-base font-black text-slate-700">0</div>
            </div>
            <div class="bg-amber-50 p-1.5 rounded border border-amber-100">
                <div class="text-amber-700 text-[10px] font-bold">遅刻</div>
                <div id="statLate" class="text-base font-black text-amber-600">0</div>
            </div>
            <div class="bg-rose-50 p-1.5 rounded border border-rose-100">
                <div class="text-rose-700 text-[10px] font-bold">キャンセル</div>
                <div id="statCancelled" class="text-base font-black text-rose-600">0</div>
            </div>
        </div>
    </section>

    <!-- Navigation Tabs (Staff View) -->
    <nav id="staffNav" class="bg-white border-b border-slate-200 sticky top-[73px] z-20">
        <div class="max-w-5xl mx-auto flex">
            <button onclick="switchTab('main')" id="tabBtn-main" class="tab-btn flex-1 py-3 text-center text-sm font-bold border-b-2 border-brand-600 text-brand-600">
                <i class="fa-solid fa-right-to-bracket text-base block mb-0.5"></i>受付画面
            </button>
            <button onclick="switchTab('tickets')" id="tabBtn-tickets" class="tab-btn flex-1 py-3 text-center text-sm font-bold border-b-2 border-transparent text-slate-500">
                <i class="fa-solid fa-list-ol text-base block mb-0.5"></i>整理券一覧
            </button>
            <button onclick="switchTab('check')" id="tabBtn-check" class="tab-btn flex-1 py-3 text-center text-sm font-bold border-b-2 border-transparent text-slate-500">
                <i class="fa-solid fa-magnifying-glass text-base block mb-0.5"></i>整理券照会
            </button>
            <button onclick="switchTab('slots')" id="tabBtn-slots" class="tab-btn flex-1 py-3 text-center text-sm font-bold border-b-2 border-transparent text-slate-500">
                <i class="fa-solid fa-calendar-days text-base block mb-0.5"></i>時間枠管理
            </button>
            <button onclick="switchTab('settings')" id="tabBtn-settings" class="tab-btn flex-1 py-3 text-center text-sm font-bold border-b-2 border-transparent text-slate-500">
                <i class="fa-solid fa-gear text-base block mb-0.5"></i>設定・権限
            </button>
        </div>
    </nav>

    <!-- Content Containers -->
    <main class="max-w-5xl mx-auto p-3 sm:p-4 flex-1 w-full">

        <!-- TAB 1: Main View (Current Admission Slot Focus) -->
        <div id="tab-main" class="tab-content space-y-4">
            
            <!-- Current Slot Hero Card -->
            <div class="bg-slate-900 text-white rounded-2xl p-4 sm:p-6 shadow-xl border border-slate-800 relative overflow-hidden">
                <div id="mainOverCapBanner" class="hidden mb-3 bg-amber-500/20 border border-amber-500 text-amber-300 text-xs px-3 py-1.5 rounded-lg flex items-center justify-between">
                    <span><i class="fa-solid fa-triangle-exclamation mr-1"></i> <strong>通常定員超過:</strong> この枠は定員9人以上に設定されています</span>
                </div>

                <div class="flex justify-between items-start">
                    <div>
                        <span class="inline-block bg-brand-500 text-white text-xs font-bold px-2.5 py-1 rounded-full mb-1">
                            現在の案内枠
                        </span>
                        <h2 id="mainSlotTime" class="text-3xl sm:text-4xl font-black tracking-tight text-white">10:00 〜 10:30</h2>
                    </div>
                    <div class="text-right">
                        <span class="text-xs text-slate-400 block">呼び出し整理券番号</span>
                        <span id="mainSlotTicketRange" class="text-2xl sm:text-3xl font-black text-amber-400 font-mono">001 〜 005</span>
                    </div>
                </div>

                <!-- Live Progress Bar -->
                <div class="mt-4">
                    <div class="flex justify-between text-xs text-slate-300 mb-1 font-semibold">
                        <span>入場状況 (<span id="mainEnteredRatio">0/5</span>人)</span>
                        <span id="mainRemainingText" class="text-emerald-400 font-bold">残り 5人</span>
                    </div>
                    <div class="w-full bg-slate-800 h-3 rounded-full overflow-hidden flex">
                        <div id="mainProgressBarEntered" class="bg-emerald-500 h-full transition-all duration-300" style="width: 0%"></div>
                        <div id="mainProgressBarLate" class="bg-amber-500 h-full transition-all duration-300" style="width: 0%"></div>
                        <div id="mainProgressBarCancelled" class="bg-rose-500 h-full transition-all duration-300" style="width: 0%"></div>
                    </div>
                </div>

                <!-- Slot Summary Chips -->
                <div class="mt-4 grid grid-cols-3 gap-2 text-center text-xs">
                    <div class="bg-slate-800/80 p-2 rounded-xl border border-slate-700/50">
                        <div class="text-emerald-400 font-bold">入場済み</div>
                        <div id="mainCountEntered" class="text-xl font-black text-emerald-400">0人</div>
                    </div>
                    <div class="bg-slate-800/80 p-2 rounded-xl border border-slate-700/50">
                        <div class="text-slate-300 font-bold">未入場</div>
                        <div id="mainCountUnentered" class="text-xl font-black text-white">0人</div>
                    </div>
                    <div class="bg-slate-800/80 p-2 rounded-xl border border-slate-700/50">
                        <div class="text-amber-400 font-bold">遅刻/候補</div>
                        <div id="mainCountLate" class="text-xl font-black text-amber-400">0人</div>
                    </div>
                </div>
            </div>

            <!-- Navigation Controls between slots -->
            <div class="flex gap-2">
                <button onclick="requireAdmin(prevSlot)" class="btn-touch flex-1 bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 font-bold py-3 px-4 rounded-xl shadow-sm flex items-center justify-center gap-2">
                    <i class="fa-solid fa-arrow-left"></i> 前の枠
                </button>
                <button onclick="requireAdmin(confirmNextSlot)" class="btn-touch flex-[2] bg-brand-600 hover:bg-brand-700 active:bg-brand-800 text-white font-bold py-3 px-4 rounded-xl shadow-md text-base flex items-center justify-center gap-2">
                    次の枠へ移動 <i class="fa-solid fa-arrow-right"></i>
                </button>
            </div>

            <!-- Current Slot Ticket Action List -->
            <div class="bg-white rounded-2xl p-4 shadow-sm border border-slate-200">
                <div class="flex justify-between items-center mb-3">
                    <h3 class="font-bold text-slate-800 text-base flex items-center gap-2">
                        <i class="fa-solid fa-ticket text-brand-600"></i>
                        現在枠の整理券一覧
                    </h3>
                    <span class="text-xs text-slate-500">ワンタップで状態切替 (要管理者権限)</span>
                </div>

                <div id="currentTicketsContainer" class="space-y-3">
                    <!-- Dynamic ticket cards -->
                </div>
            </div>

            <!-- Next Slot Preview Card -->
            <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4">
                <div class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">NEXT SLOT (次の入場枠)</div>
                <div class="flex justify-between items-center">
                    <div>
                        <div id="nextSlotTime" class="text-lg font-bold text-slate-800">10:30 〜 11:00</div>
                        <div id="nextSlotTickets" class="text-xs font-medium text-slate-500">整理券 006〜010 (定員5人)</div>
                    </div>
                    <div id="nextSlotStatus" class="text-xs font-bold bg-slate-200 text-slate-700 px-3 py-1.5 rounded-lg">
                        待機中
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 2: All Tickets List -->
        <div id="tab-tickets" class="tab-content hidden space-y-4">
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-4">
                    <h2 class="text-lg font-bold text-slate-800">全整理券 一覧・検索</h2>
                    <div class="flex flex-wrap gap-1 w-full sm:w-auto text-xs font-semibold">
                        <button onclick="filterTickets('all')" id="filterBtn-all" class="filter-btn px-3 py-1.5 rounded-lg bg-brand-600 text-white">すべて</button>
                        <button onclick="filterTickets('unentered')" id="filterBtn-unentered" class="filter-btn px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700">未入場</button>
                        <button onclick="filterTickets('entered')" id="filterBtn-entered" class="filter-btn px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700">入場済</button>
                        <button onclick="filterTickets('late')" id="filterBtn-late" class="filter-btn px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700">遅刻</button>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="relative">
                        <input type="number" id="ticketSearchInput" oninput="renderAllTickets()" placeholder="整理券番号で絞り込み (例: 5)" class="w-full bg-slate-50 border border-slate-300 rounded-xl py-2.5 pl-10 pr-4 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                        <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3 text-slate-400 text-sm"></i>
                    </div>
                </div>

                <div id="allTicketsList" class="divide-y divide-slate-100 max-h-[60vh] overflow-y-auto no-scrollbar pr-1">
                    <!-- Dynamic tickets list -->
                </div>
            </div>
        </div>

        <!-- TAB 3: Ticket Verification -->
        <div id="tab-check" class="tab-content hidden space-y-4">
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 text-center">
                <i class="fa-solid fa-id-card text-4xl text-brand-600 mb-2"></i>
                <h2 class="text-xl font-bold text-slate-800">整理券番号 確認・照会</h2>
                <p class="text-xs text-slate-500 mt-1 mb-4">お客様の整理券番号を入力して、時間枠・受付状況を確認します</p>

                <div class="max-w-xs mx-auto space-y-3">
                    <div class="relative">
                        <input type="number" id="checkTicketInput" placeholder="番号を入力" class="w-full text-center text-3xl font-mono font-bold tracking-wider py-3 border-2 border-slate-300 rounded-xl focus:border-brand-500 focus:outline-none bg-slate-50">
                    </div>

                    <button onclick="verifyTicketNumber()" class="btn-touch w-full bg-brand-600 hover:bg-brand-700 text-white font-bold py-3 rounded-xl text-base shadow">
                        <i class="fa-solid fa-check-double mr-1"></i> 整理券を確認する
                    </button>
                </div>

                <div class="max-w-xs mx-auto grid grid-cols-3 gap-2 mt-4 text-slate-700 font-bold">
                    <button onclick="keypadPress('1')" class="bg-slate-100 active:bg-slate-300 py-3 rounded-xl text-lg shadow-sm">1</button>
                    <button onclick="keypadPress('2')" class="bg-slate-100 active:bg-slate-300 py-3 rounded-xl text-lg shadow-sm">2</button>
                    <button onclick="keypadPress('3')" class="bg-slate-100 active:bg-slate-300 py-3 rounded-xl text-lg shadow-sm">3</button>
                    <button onclick="keypadPress('4')" class="bg-slate-100 active:bg-slate-300 py-3 rounded-xl text-lg shadow-sm">4</button>
                    <button onclick="keypadPress('5')" class="bg-slate-100 active:bg-slate-300 py-3 rounded-xl text-lg shadow-sm">5</button>
                    <button onclick="keypadPress('6')" class="bg-slate-100 active:bg-slate-300 py-3 rounded-xl text-lg shadow-sm">6</button>
                    <button onclick="keypadPress('7')" class="bg-slate-100 active:bg-slate-300 py-3 rounded-xl text-lg shadow-sm">7</button>
                    <button onclick="keypadPress('8')" class="bg-slate-100 active:bg-slate-300 py-3 rounded-xl text-lg shadow-sm">8</button>
                    <button onclick="keypadPress('9')" class="bg-slate-100 active:bg-slate-300 py-3 rounded-xl text-lg shadow-sm">9</button>
                    <button onclick="keypadPress('C')" class="bg-rose-100 text-rose-700 active:bg-rose-200 py-3 rounded-xl text-sm shadow-sm">クリア</button>
                    <button onclick="keypadPress('0')" class="bg-slate-100 active:bg-slate-300 py-3 rounded-xl text-lg shadow-sm">0</button>
                    <button onclick="keypadPress('DEL')" class="bg-slate-200 text-slate-700 active:bg-slate-300 py-3 rounded-xl text-sm shadow-sm"><i class="fa-solid fa-backspace"></i></button>
                </div>
            </div>

            <div id="checkResultContainer" class="hidden"></div>
        </div>

        <!-- TAB 4: Time Slot Management -->
        <div id="tab-slots" class="tab-content hidden space-y-4">
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200">
                <div class="flex justify-between items-center mb-2">
                    <h2 class="text-lg font-bold text-slate-800">時間枠・定員管理</h2>
                    <span class="text-xs text-slate-500">要管理者権限</span>
                </div>
                <p class="text-xs text-slate-500 mb-4">各枠の開始・終了時刻を直接入力して個別調整できます。定員は5〜8人推奨（9人以上は警告表示）。</p>

                <div id="slotListContainer" class="space-y-3"></div>
            </div>
        </div>

        <!-- TAB 5: Settings & Security -->
        <div id="tab-settings" class="tab-content hidden space-y-4">
            <!-- Custom Domain Base URL Option (Solves blob: URL issue) -->
            <div class="bg-amber-50 border border-amber-200 p-5 rounded-2xl space-y-3">
                <h2 class="text-base font-bold text-amber-900 flex items-center gap-2">
                    <i class="fa-solid fa-link text-amber-600"></i>
                    共有用ベースURLの設定（QRコード・共有リンク用）
                </h2>
                <p class="text-xs text-amber-800 leading-relaxed">
                    プレビュー環境などの場合、自動生成されたURL（<code>blob:https://...</code>）では他のスマホからアクセスできません。公開先サーバーのWebアドレス（例: <code>https://my-event.com/index.html</code>）を入力しておくと、正しい共有QRコードを生成できます。
                </p>

                <div class="flex gap-2 items-center">
                    <input type="text" id="inputCustomBaseUrl" placeholder="例: https://your-site.com/app.html" class="flex-1 bg-white border border-amber-300 rounded-xl p-2.5 text-xs font-mono">
                    <button onclick="saveCustomBaseUrl()" class="btn-touch bg-amber-600 hover:bg-amber-700 text-white font-bold px-4 rounded-xl text-xs">
                        保存
                    </button>
                </div>
            </div>

            <!-- Security & Admin PIN Settings Card -->
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 space-y-3">
                <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                    <i class="fa-solid fa-shield-halved text-brand-600"></i>
                    編集権限・管理者設定
                </h2>
                <p class="text-xs text-slate-600 leading-relaxed">
                    あなたが管理者として編集を行うための暗証番号（PIN）を設定します。閲覧者（他スタッフや来場者）はこの番号を知らない限りデータを変更できません。
                </p>

                <div class="flex gap-2 items-center">
                    <div class="flex-1">
                        <label class="block text-xs font-bold text-slate-700 mb-1">管理者PINコード (4桁〜数字)</label>
                        <input type="password" id="inputAdminPin" value="1234" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 font-mono text-center font-bold text-lg">
                    </div>
                    <button onclick="saveAdminPin()" class="btn-touch bg-brand-600 hover:bg-brand-700 text-white font-bold px-4 rounded-xl text-sm mt-5">
                        保存
                    </button>
                </div>

                <div class="pt-2 border-t flex justify-between items-center text-xs">
                    <span class="text-slate-500">現在のセッション状態:</span>
                    <span id="sessionStatusBadge" class="bg-emerald-100 text-emerald-800 font-bold px-2.5 py-1 rounded-full">管理者権限あり</span>
                </div>
            </div>

            <!-- Event Summary Card -->
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
                <h2 class="text-lg font-bold text-slate-800 mb-3 flex items-center gap-2">
                    <i class="fa-solid fa-chart-pie text-brand-600"></i>
                    本日のイベント集計データ
                </h2>

                <div class="grid grid-cols-2 gap-3 mb-4">
                    <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 text-center">
                        <div class="text-xs text-slate-500">総整理券発行数</div>
                        <div id="summaryTotal" class="text-2xl font-black text-slate-800">0 枚</div>
                    </div>
                    <div class="bg-emerald-50 p-3 rounded-xl border border-emerald-200 text-center">
                        <div class="text-xs text-emerald-700">総入場完了者</div>
                        <div id="summaryEntered" class="text-2xl font-black text-emerald-600">0 人</div>
                    </div>
                    <div class="bg-amber-50 p-3 rounded-xl border border-amber-200 text-center">
                        <div class="text-xs text-amber-700">総遅刻者</div>
                        <div id="summaryLate" class="text-2xl font-black text-amber-600">0 人</div>
                    </div>
                    <div class="bg-rose-50 p-3 rounded-xl border border-rose-200 text-center">
                        <div class="text-xs text-rose-700">総キャンセル</div>
                        <div id="summaryCancelled" class="text-2xl font-black text-rose-600">0 人</div>
                    </div>
                </div>
            </div>

            <!-- Event Configuration Form -->
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 space-y-4">
                <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                    <i class="fa-solid fa-sliders text-brand-600"></i>
                    スケジュール再生成
                </h2>

                <div class="space-y-3 text-sm">
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">イベント開始時刻</label>
                        <input type="time" id="cfgStartTime" value="10:00" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 font-bold">
                    </div>

