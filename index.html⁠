    <!-- Firebase Module Scripts -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, setDoc, onSnapshot } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Firebase Initialization with standard global configs
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-event-app';
        const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {
            apiKey: "demo-api-key",
            authDomain: "demo.firebaseapp.com",
            projectId: "demo-project",
            storageBucket: "demo.appspot.com",
            messagingSenderId: "123456789",
            appId: "1:123456789:web:abcdef"
        };

        let db, auth;
        let isCloudConnected = false;
        let pendingAction = null;

        // Application Main State
        window.appData = {
            config: {
                startTime: '10:00',
                slotInterval: 30,
                defaultCapacity: 5,
                totalSlots: 10,
                startTicketNum: 1,
                adminPin: '1234',
                customBaseUrl: ''
            },
            currentSlotIndex: 0,
            delayMinutes: 0,
            slots: [],
            tickets: {}
        };

        window.isAthorizedAdmin = false;
        let currentFilter = 'all';

        // Initialize Firebase Sync
        async function initFirebase() {
            try {
                const app = initializeApp(firebaseConfig);
                auth = getAuth(app);
                db = getFirestore(app);

                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    await signInWithCustomToken(auth, __initial_auth_token);
                } else {
                    await signInAnonymously(auth);
                }

                // Listen to Firestore document updates (Shared data path)
                const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'events', 'live_state');
                onSnapshot(docRef, (docSnap) => {
                    if (docSnap.exists()) {
                        const remoteData = docSnap.data();
                        if (remoteData && remoteData.appData) {
                            window.appData = remoteData.appData;
                            updateSyncBadge('online');
                            renderAll();
                        }
                    } else {
                        // Push initial state
                        saveDataToCloud();
                    }
                }, (error) => {
                    console.warn("Firestore offline fallback mode:", error);
                    updateSyncBadge('offline');
                });

                isCloudConnected = true;
            } catch (e) {
                console.warn("Firebase Auth/Firestore failed, defaulting to local state.", e);
                updateSyncBadge('offline');
            }
        }

        function updateSyncBadge(status) {
            const badge = document.getElementById('cloudSyncBadge');
            const dot = document.getElementById('syncDot');
            const text = document.getElementById('syncText');

            if (status === 'online') {
                dot.className = 'w-2 h-2 rounded-full bg-emerald-400 animate-pulse';
                text.textContent = '同期中';
            } else {
                dot.className = 'w-2 h-2 rounded-full bg-slate-400';
                text.textContent = 'オフライン';
            }
        }

        // Save State Logic
        window.saveData = function() {
            localStorage.setItem('event_mgmt_local_data', JSON.stringify(window.appData));
            if (isCloudConnected) {
                saveDataToCloud();
            }
            renderAll();
        };

        async function saveDataToCloud() {
            if (!db) return;
            try {
                const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'events', 'live_state');
                await setDoc(docRef, {
                    appData: window.appData,
                    updatedAt: new Date().toISOString()
                });
            } catch (e) {
                console.error("Cloud save failed:", e);
            }
        }

        // On Page Load Initialization
        window.addEventListener('load', () => {
            loadLocalData();
            initFirebase();
            startClock();
            
            // Check URL parameters for view mode
            const urlParams = new URLSearchParams(window.location.search);
            const mode = urlParams.get('mode');
            if (mode === 'display') {
                switchViewMode('display');
            } else if (mode === 'viewer') {
                window.isAthorizedAdmin = false;
                document.getElementById('roleBadge').textContent = '閲覧者';
                document.getElementById('roleBadge').className = 'bg-slate-700 text-white font-bold text-xs px-2 py-0.5 rounded tracking-wider';
            } else {
                // Default Admin Session
                window.isAthorizedAdmin = true;
            }

            renderAll();
        });

        function loadLocalData() {
            const saved = localStorage.getItem('event_mgmt_local_data');
            if (saved) {
                try {
                    window.appData = JSON.parse(saved);
                } catch(e) {
                    initDefaultData();
                }
            } else {
                initDefaultData();
            }
        }

        function initDefaultData() {
            window.appData = {
                config: {
                    startTime: '10:00',
                    slotInterval: 30,
                    defaultCapacity: 5,
                    totalSlots: 10,
                    startTicketNum: 1,
                    adminPin: '1234',
                    customBaseUrl: ''
                },
                currentSlotIndex: 0,
                delayMinutes: 0,
                slots: [],
                tickets: {}
            };
            generateSlotsAndTickets();
        }

        window.generateSlotsAndTickets = function() {
            const { startTime, slotInterval = 30, defaultCapacity, totalSlots, startTicketNum } = window.appData.config;
            const [startH, startM] = startTime.split(':').map(Number);

            window.appData.slots = [];
            let currentTicketCounter = Number(startTicketNum);
            const intervalNum = Number(slotInterval);

            for (let i = 0; i < totalSlots; i++) {
                const slotStartTotalMin = startH * 60 + startM + (i * intervalNum);
                const slotEndTotalMin = slotStartTotalMin + intervalNum;

                const sh = String(Math.floor(slotStartTotalMin / 60) % 24).padStart(2, '0');
                const sm = String(slotStartTotalMin % 60).padStart(2, '0');
                const eh = String(Math.floor(slotEndTotalMin / 60) % 24).padStart(2, '0');
                const em = String(slotEndTotalMin % 60).padStart(2, '0');

                const existingCap = window.appData.slots[i] ? window.appData.slots[i].capacity : defaultCapacity;
                const capacity = existingCap;

                const startTicket = currentTicketCounter;
                const endTicket = currentTicketCounter + capacity - 1;
                currentTicketCounter += capacity;

                window.appData.slots.push({
                    index: i,
                    startTimeStr: `${sh}:${sm}`,
                    endTimeStr: `${eh}:${em}`,
                    capacity: capacity,
                    startTicket: startTicket,
                    endTicket: endTicket
                });
            }
            rebuildTicketsMap();
        };

        function rebuildTicketsMap() {
            const newTickets = {};
            window.appData.slots.forEach(slot => {
                for (let num = slot.startTicket; num <= slot.endTicket; num++) {
                    const ticketId = num;
                    const existingStatus = window.appData.tickets[ticketId] ? window.appData.tickets[ticketId].status : 'unentered';
                    newTickets[ticketId] = {
                        id: ticketId,
                        slotIndex: slot.index,
                        status: existingStatus
                    };
                }
            });
            window.appData.tickets = newTickets;
        }

